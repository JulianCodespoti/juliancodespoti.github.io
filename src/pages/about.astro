---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../site.config";
---

<BaseLayout
  title={`About - ${SITE.brand}`}
  description={`About ${SITE.author} and ${SITE.brand}.`}
  activeNav="about"
>
  <main class="col-page">
    <h1 class="page-title">About</h1>
    <div class="post-prose">
      <p>
        I'm {SITE.author} (hence <code>{SITE.brand}</code>). I enjoy building fast, local-first software and pulling systems apart until their behavior is obvious at a glance.
      </p>
      <p>
        Every post here pairs plain engineering notes with small live simulations running the real underlying algorithms in your browser, so you can poke at memory, latency, and back-pressure yourself rather than taking benchmarks on faith.
      </p>

      <h2>What I'm building</h2>
      <ul>
        {SITE.projects.map((project) => (
          <li>
            <a href={project.url} target="_blank" rel="noopener noreferrer">{project.name}</a>: {project.summary}
          </li>
        ))}
      </ul>

      <h2>Elsewhere</h2>
      <ul>
        <li><a href={SITE.githubUrl} target="_blank" rel="noopener noreferrer">GitHub (@{SITE.githubUser})</a></li>
        <li><a href="/rss.xml">RSS feed</a></li>
      </ul>
    </div>
  </main>
</BaseLayout>
