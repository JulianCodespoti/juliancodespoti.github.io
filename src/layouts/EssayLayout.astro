---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  subtitle: string;
  description: string;
  pubDate: Date;
  readingTime: string;
  repoUrl?: string;
}

const { title, subtitle, description, pubDate, readingTime, repoUrl } = Astro.props;
const formattedDate = pubDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<BaseLayout title={`${title} - Julian Codespoti`} description={description} activeNav="essays">
  <main class="col-page">
    <article>
      <header class="essay-header">
        <div class="essay-meta">
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
          <span> / {readingTime}</span>
          {repoUrl && (
            <>
              <span> / </span>
              <a href={repoUrl} target="_blank" rel="noopener noreferrer">source</a>
            </>
          )}
        </div>
        <h1 class="page-title">{title}</h1>
        <p class="page-sub" style="margin-bottom: 0;">{subtitle}</p>
      </header>

      <div class="essay-prose">
        <slot />
      </div>
    </article>
  </main>
</BaseLayout>
