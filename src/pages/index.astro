---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Julian Codespoti"
  description="Interactive deep-dives on how systems work: memory, streaming, networking, and local-first tools."
  activeNav="posts"
>
  <main class="col-page">
    <h1 class="page-title">Posts</h1>
    <p class="page-sub">
      Interactive breakdowns of how software actually works under the hood, with small live visuals so you can see every mechanism in motion.
    </p>

    <ul class="post-list">
      {posts.map((post) => {
        const date = post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
        return (
          <li>
            <a href={`/posts/${post.slug}/`}>
              <div class="post-list-meta">
                <time datetime={post.data.pubDate.toISOString()}>{date}</time>
                <span> / {post.data.readingTime}</span>
              </div>
              <h2>{post.data.title}</h2>
              <p>{post.data.subtitle}</p>
            </a>
          </li>
        );
      })}
    </ul>
  </main>
</BaseLayout>
