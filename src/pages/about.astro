---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../site.config";
---

<BaseLayout
  title={`About - ${SITE.brand}`}
  description={`About ${SITE.author} and ${SITE.brand}.`}
  activeNav="about"
>
  <main class="col-page" id="main-content">
    <h1 class="page-title">About</h1>
    <div class="post-prose">
      <p>
        I'm {SITE.author} (hence <code>{SITE.brand}</code>). I build fast, local-first software and like pulling systems apart until you can actually see how they behave.
      </p>
      <p>
        Most posts here include small live simulations running in your browser so you can poke at memory, latency, and context limits yourself instead of taking benchmarks on faith.
      </p>

      <h2>Projects</h2>
      <ul>
        {SITE.projects.map((project) => (
          <li>
            <a href={project.url} target="_blank" rel="noopener noreferrer">{project.name}</a>: {project.summary}
          </li>
        ))}
      </ul>

      <h2>How this site is built</h2>
      <p>
        Static Astro and MDX, zero analytics trackers, zero third-party embeds, and small hand-drawn HTML5 canvas simulations backed by unit-tested TypeScript models. Every figure responds live to both dark and light paper themes (press <code>T</code> anywhere to switch) and pauses automatically when off-screen.
      </p>

      <h2>Links</h2>
      <ul>
        <li><a href={SITE.githubUrl} target="_blank" rel="noopener noreferrer">GitHub (@{SITE.githubUser})</a></li>
        <li><a href="/rss.xml">RSS feed</a></li>
      </ul>
    </div>
  </main>
</BaseLayout>
