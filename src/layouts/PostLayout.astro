---
import BaseLayout from "./BaseLayout.astro";
import { SITE } from "../site.config";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface AdjacentPost {
  slug: string;
  title: string;
}

interface Props {
  slug: string;
  title: string;
  subtitle: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  readingTime: string;
  tags?: string[];
  repoUrl?: string;
  headings?: Heading[];
  prevPost?: AdjacentPost;
  nextPost?: AdjacentPost;
}

const {
  slug,
  title,
  subtitle,
  description,
  pubDate,
  updatedDate,
  readingTime,
  tags = [],
  repoUrl,
  headings = [],
  prevPost,
  nextPost,
} = Astro.props;

const formattedDate = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});

const tocItems = headings.filter((h) => h.depth === 2);
const canonical = new URL(`/posts/${slug}/`, Astro.site ?? SITE.siteUrl).toString();
const ogImage = `/og/${slug}.png`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: {
    "@type": "Person",
    name: SITE.author,
    url: SITE.siteUrl,
  },
  publisher: {
    "@type": "Person",
    name: SITE.author,
  },
  mainEntityOfPage: canonical,
  image: new URL(ogImage, Astro.site ?? SITE.siteUrl).toString(),
  keywords: tags.join(", "),
};
---

<BaseLayout
  title={`${title} - ${SITE.brand}`}
  description={description}
  activeNav="posts"
  ogImage={ogImage}
  ogType="article"
  publishedTime={pubDate.toISOString()}
  jsonLd={jsonLd}
>
  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>

  <main class="post-shell" id="main-content">
    {tocItems.length >= 2 && (
      <aside class="post-toc" aria-label="On this page">
        <div class="post-toc-title">On this page</div>
        <ul>
          {tocItems.map((h) => (
            <li>
              <a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a>
            </li>
          ))}
        </ul>
      </aside>
    )}

    <article>
      <header class="post-header">
        <div class="post-meta">
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
          <span>·</span>
          <span>{readingTime}</span>
          {tags.length > 0 && (
            <>
              <span>·</span>
              <span>{tags.join(", ")}</span>
            </>
          )}
          {repoUrl && (
            <>
              <span>·</span>
              <a href={repoUrl} target="_blank" rel="noopener noreferrer">Source</a>
            </>
          )}
        </div>
        <h1 class="page-title">{title}</h1>
        <p class="page-sub" style="margin-bottom: 0;">{subtitle}</p>
      </header>

      <div class="post-prose" id="post-prose">
        <slot />
      </div>

      <aside class="post-rss-box" aria-label="Follow new essays">
        <div>
          <div class="post-rss-title">More interactive essays like this</div>
          <p class="post-rss-copy">Published occasionally on systems, AI mechanics, and visual math. Follow via RSS or GitHub.</p>
        </div>
        <div class="post-rss-actions">
          <a class="ui-btn ui-btn--accent" href="/rss.xml">RSS Feed</a>
          <button type="button" class="ui-btn" id="copy-rss-btn">Copy RSS URL</button>
        </div>
      </aside>

      <nav class="post-end" aria-label="Post navigation">
        {prevPost ? (
          <a class="post-nav-card" href={`/posts/${prevPost.slug}/`}>
            <span class="post-nav-kicker">Previous essay</span>
            <span class="post-nav-title">{prevPost.title}</span>
          </a>
        ) : (
          <a class="post-nav-card" href="/">
            <span class="post-nav-kicker">Archive</span>
            <span class="post-nav-title">All essays</span>
          </a>
        )}
        {nextPost ? (
          <a class="post-nav-card post-nav-card--next" href={`/posts/${nextPost.slug}/`}>
            <span class="post-nav-kicker">Next essay</span>
            <span class="post-nav-title">{nextPost.title}</span>
          </a>
        ) : (
          <a class="post-nav-card post-nav-card--next" href="/about/">
            <span class="post-nav-kicker">About</span>
            <span class="post-nav-title">About {SITE.brand}</span>
          </a>
        )}
      </nav>
    </article>
  </main>

  <script is:inline>
    (() => {
      // 1. Reading progress hairline + deterministic TOC scrollspy
      const bar = document.getElementById("reading-progress");
      const prose = document.getElementById("post-prose");
      const tocLinks = Array.from(document.querySelectorAll("[data-toc-link]"));
      const h2s = prose ? Array.from(prose.querySelectorAll("h2[id]")) : [];

      const setActiveToc = (slug) => {
        tocLinks.forEach((el) => {
          const active = el.getAttribute("data-toc-link") === slug;
          el.setAttribute("data-active", active ? "true" : "false");
          if (active) el.setAttribute("aria-current", "location");
          else el.removeAttribute("aria-current");
        });
      };

      let scrollTicking = false;
      const syncOnScroll = () => {
        scrollTicking = false;
        if (bar) {
          const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
          const pct = Math.min(100, Math.max(0, (window.scrollY / max) * 100));
          bar.style.width = pct.toFixed(2) + "%";
        }
        if (tocLinks.length > 0 && h2s.length > 0) {
          const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 24;
          if (atBottom) {
            setActiveToc(h2s[h2s.length - 1].id);
          } else {
            let current = h2s[0].id;
            for (const h of h2s) {
              if (h.getBoundingClientRect().top <= 140) {
                current = h.id;
              } else {
                break;
              }
            }
            setActiveToc(current);
          }
        }
      };

      const scheduleScrollSync = () => {
        if (scrollTicking) return;
        scrollTicking = true;
        window.requestAnimationFrame(syncOnScroll);
      };

      window.addEventListener("scroll", scheduleScrollSync, { passive: true });
      window.addEventListener("resize", scheduleScrollSync, { passive: true });
      syncOnScroll();

      if (prose) {
        // 2. Clickable heading anchors with permalink copy
        const headings = Array.from(prose.querySelectorAll("h2[id], h3[id]"));
        headings.forEach((h) => {
          if (h.querySelector(".heading-anchor")) return;
          const a = document.createElement("a");
          a.className = "heading-anchor";
          a.href = "#" + h.id;
          a.setAttribute("aria-label", "Copy link to section " + (h.textContent || ""));
          a.textContent = "#";
          a.addEventListener("click", async () => {
            const url = new URL("#" + h.id, window.location.href).toString();
            try {
              await navigator.clipboard.writeText(url);
              a.textContent = "copied";
              a.dataset.copied = "true";
              window.setTimeout(() => {
                a.textContent = "#";
                delete a.dataset.copied;
              }, 1400);
            } catch {}
          });
          h.appendChild(a);
        });

        // 3. Framed header bar + Copy button on fenced code blocks (zero line-1 overlap)
        prose.querySelectorAll("pre").forEach((pre) => {
          if (pre.parentElement?.classList.contains("code-block-wrap")) return;
          const wrap = document.createElement("div");
          wrap.className = "code-block-wrap";
          pre.parentNode?.insertBefore(wrap, pre);

          const header = document.createElement("div");
          header.className = "code-block-bar";

          const lang = document.createElement("span");
          lang.className = "code-block-lang";
          const rawLang = (pre.getAttribute("data-language") || "").trim();
          lang.textContent = rawLang && rawLang !== "plaintext" ? rawLang : "code";

          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "code-copy-btn";
          btn.textContent = "Copy";
          btn.addEventListener("click", async () => {
            try {
              await navigator.clipboard.writeText(pre.textContent || "");
              btn.textContent = "Copied";
              window.setTimeout(() => { btn.textContent = "Copy"; }, 1400);
            } catch {}
          });

          header.appendChild(lang);
          header.appendChild(btn);
          wrap.appendChild(header);
          wrap.appendChild(pre);
        });

        // 4. Responsive horizontal scroll wrapper for Markdown tables
        prose.querySelectorAll("table").forEach((table) => {
          if (table.parentElement?.classList.contains("table-wrap")) return;
          const wrap = document.createElement("div");
          wrap.className = "table-wrap";
          table.parentNode?.insertBefore(wrap, table);
          wrap.appendChild(table);
        });
      }

      // 5. Copy RSS URL button in post footer
      const copyRssBtn = document.getElementById("copy-rss-btn");
      copyRssBtn?.addEventListener("click", async () => {
        try {
          const rssUrl = new URL("/rss.xml", window.location.origin).toString();
          await navigator.clipboard.writeText(rssUrl);
          copyRssBtn.textContent = "Copied";
          window.setTimeout(() => { copyRssBtn.textContent = "Copy RSS URL"; }, 1500);
        } catch {}
      });
    })();
  </script>
</BaseLayout>
