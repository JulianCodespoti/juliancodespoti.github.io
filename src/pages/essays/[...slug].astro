---
import { getCollection, type CollectionEntry } from "astro:content";
import EssayLayout from "../../layouts/EssayLayout.astro";

export async function getStaticPaths() {
  const essays = await getCollection("essays", ({ data }) => !data.draft);
  return essays.map((essay) => ({
    params: { slug: essay.slug },
    props: { essay },
  }));
}

interface Props {
  essay: CollectionEntry<"essays">;
}

const { essay } = Astro.props;
const { Content, headings } = await essay.render();
---

<EssayLayout
  title={essay.data.title}
  subtitle={essay.data.subtitle}
  description={essay.data.description}
  pubDate={essay.data.pubDate}
  readingTime={essay.data.readingTime}
  simsCount={essay.data.simsCount}
  tags={essay.data.tags}
  repoUrl={essay.data.repoUrl}
  headings={headings}
>
  <Content />
</EssayLayout>
