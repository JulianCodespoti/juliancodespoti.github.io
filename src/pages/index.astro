---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { HeroField } from "../components/HeroField";
import { PostPreview } from "../figures/previews";
import { SITE } from "../site.config";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const tagCounts = new Map<string, number>();
for (const p of posts) {
  for (const t of p.data.tags) {
    tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
  }
}

// Show only meaningful topic clusters (>= 2 posts) so the filter bar stays calm and scannable
const filterTags = Array.from(tagCounts.entries())
  .filter(([, count]) => count >= 2)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([tag]) => tag);

const showTagFilter = posts.length >= 3 && filterTags.length >= 2;
const totalSims = posts.reduce((acc, p) => acc + (p.data.simsCount ?? 0), 0);
---

<BaseLayout
  title={SITE.brand}
  description={SITE.tagline}
  activeNav="posts"
>
  <main class="col-page" id="main-content">
    <section class="home-hero">
      <h1 class="home-greeting">Hey, I'm {SITE.shortName}.</h1>
      <p class="home-bio">
        I build local-first tools in Rust and pull systems apart until you can see how they actually work.
      </p>
      <HeroField client:load />
    </section>

    <section class="home-section" aria-labelledby="writing-heading">
      <div class="section-header-row">
        <h2 class="section-kicker" id="writing-heading">Writing</h2>
        <span class="section-sub-note">{posts.length} essays · {totalSims} live figures</span>
      </div>

      {showTagFilter && (
        <div class="tag-bar" role="group" aria-label="Filter posts by topic">
          <button type="button" class="ui-btn ui-btn--active" data-tag-filter="all" aria-pressed="true">
            All <span class="tag-count">{posts.length}</span>
          </button>
          {filterTags.map((tag) => (
            <button type="button" class="ui-btn" data-tag-filter={tag} aria-pressed="false">
              {tag} <span class="tag-count">{tagCounts.get(tag)}</span>
            </button>
          ))}
        </div>
      )}

      <ul class="post-feed">
        {posts.map((post) => {
          const date = post.data.pubDate.toLocaleDateString("en-US", {
            year: "numeric",
            month: "short",
            day: "numeric",
          });
          const hasPreview = Boolean(post.data.preview);
          return (
            <li class="post-feed-item" data-tags={post.data.tags.join(",")}>
              <a class={hasPreview ? "post-card" : "post-card post-card--no-preview"} href={`/posts/${post.slug}/`}>
                {hasPreview && (
                  <div class="post-card-preview" aria-hidden="true">
                    <PostPreview id={post.data.preview!} client:visible />
                  </div>
                )}
                <div>
                  <div class="post-card-meta">
                    <time datetime={post.data.pubDate.toISOString()}>{date}</time>
                    <span>·</span>
                    <span>{post.data.readingTime}</span>
                    {post.data.simsCount > 0 && (
                      <>
                        <span>·</span>
                        <span class="post-card-sims">{post.data.simsCount} figures</span>
                      </>
                    )}
                  </div>
                  <h3 class="post-card-title">{post.data.title}</h3>
                  <p class="post-card-sub">{post.data.subtitle}</p>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </section>

    <section class="home-section" aria-labelledby="projects-heading">
      <div class="section-header-row">
        <h2 class="section-kicker" id="projects-heading">Projects</h2>
      </div>
      <ul class="project-list">
        {SITE.projects.map((project) => (
          <li class="project-row">
            <div class="project-row-head">
              <div class="project-title-group">
                <a class="project-name" href={project.url} target="_blank" rel="noopener noreferrer">
                  {project.name}
                </a>
                {project.demoUrl && (
                  <a class="project-demo-link" href={project.demoUrl} target="_blank" rel="noopener noreferrer">
                    Live demo
                  </a>
                )}
              </div>
              <span class="project-stack">{project.stack}</span>
            </div>
            <p class="project-desc">{project.summary}</p>
          </li>
        ))}
      </ul>
    </section>
  </main>

  {showTagFilter && (
    <script is:inline>
      (() => {
        const buttons = Array.from(document.querySelectorAll("[data-tag-filter]"));
        const items = Array.from(document.querySelectorAll(".post-feed-item"));
        const validTags = new Set(buttons.map((b) => b.getAttribute("data-tag-filter") || "all"));

        const applyTag = (tag, updateUrl) => {
          const activeTag = validTags.has(tag) ? tag : "all";
          buttons.forEach((b) => {
            const match = (b.getAttribute("data-tag-filter") || "all") === activeTag;
            b.classList.toggle("ui-btn--active", match);
            b.setAttribute("aria-pressed", String(match));
          });
          items.forEach((el) => {
            const tags = (el.getAttribute("data-tags") || "").split(",");
            el.style.display = activeTag === "all" || tags.includes(activeTag) ? "" : "none";
          });
          if (updateUrl && window.history && window.history.replaceState) {
            const url = new URL(window.location.href);
            if (activeTag === "all") url.searchParams.delete("tag");
            else url.searchParams.set("tag", activeTag);
            window.history.replaceState(null, "", url.pathname + url.search + url.hash);
          }
        };

        buttons.forEach((btn) => {
          btn.addEventListener("click", () => {
            applyTag(btn.getAttribute("data-tag-filter") || "all", true);
          });
        });

        const initial = new URLSearchParams(window.location.search).get("tag");
        if (initial) applyTag(initial, false);
      })();
    </script>
  )}
</BaseLayout>
