---
import "@fontsource/newsreader/400.css";
import "@fontsource/newsreader/500.css";
import "@fontsource/newsreader/600.css";
import "@fontsource/newsreader/400-italic.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "../styles/global.css";
import { SITE } from "../site.config";

interface Props {
  title: string;
  description: string;
  activeNav?: "posts" | "about";
  ogImage?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  activeNav,
  ogImage = "/og/home.png",
  ogType = "website",
  publishedTime,
  jsonLd,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? SITE.siteUrl);
const ogImageUrl = new URL(ogImage, Astro.site ?? SITE.siteUrl);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.brand} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("spoti-theme");
          if (saved === "light" || saved === "dark") {
            document.documentElement.dataset.theme = saved;
          }
        } catch {}
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="site-brand" href="/" aria-label={`${SITE.brand} home`}>
          <svg class="brand-mark" width="24" height="24" viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <rect width="64" height="64" rx="14" fill="var(--stage-sub)" stroke="var(--line-strong)" stroke-width="2" />
            <path d="M23 18H16V46H23" stroke="var(--fg)" stroke-width="4.2" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M41 18H48V46H41" stroke="var(--fg)" stroke-width="4.2" stroke-linecap="round" stroke-linejoin="round" />
            <line class="brand-slash" x1="36" y1="16" x2="28" y2="48" stroke="var(--copper)" stroke-width="4.5" stroke-linecap="round" />
          </svg>
          <span class="brand-wordmark">{SITE.brand}</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          <a href="/" aria-current={activeNav === "posts" ? "page" : undefined}>Posts</a>
          <a href="/about/" aria-current={activeNav === "about" ? "page" : undefined}>About</a>
          <a href={SITE.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
          <button type="button" class="theme-pill" id="theme-toggle" aria-label="Switch color theme">
            <span id="theme-label">Dark</span>
          </button>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="site-footer-inner">
        <span class="footer-brand">{SITE.brand}</span>
        <div class="footer-links">
          <a href="/">Posts</a>
          <a href="/about/">About</a>
          <a href={SITE.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="/rss.xml">RSS</a>
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const btn = document.getElementById("theme-toggle");
        const lbl = document.getElementById("theme-label");
        const sync = () => {
          const isLight = document.documentElement.dataset.theme === "light";
          if (lbl) lbl.textContent = isLight ? "Light" : "Dark";
        };
        btn?.addEventListener("click", () => {
          const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem("spoti-theme", next); } catch {}
          sync();
        });
        sync();
      })();
    </script>
  </body>
</html>
